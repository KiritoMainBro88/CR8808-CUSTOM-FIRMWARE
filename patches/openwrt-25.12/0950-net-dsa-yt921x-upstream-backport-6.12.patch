From: David Yang <mmyangfl@gmail.com>
Subject: [PATCH] net: dsa: yt921x: Backport upstream Motorcomm YT921x switch driver to Linux 6.12 LTS

Backport clean upstream monolithic driver for Motorcomm YT921x series switches
(David Yang, net-next / Linux 6.19+) to Linux 6.12 LTS in OpenWrt 25.12.6.
Provides single-conduit tagged DSA on Port 8 (SGMII 1000M) without out-of-tree vendor hooks.

--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -40,6 +40,7 @@
 #define DSA_TAG_PROTO_8021Q_VALUE		12
 #define DSA_TAG_PROTO_SJA1105_VALUE		13
 #define DSA_TAG_PROTO_KSZ8795_VALUE		14
+#define DSA_TAG_PROTO_YT921X_VALUE		32
 #define DSA_TAG_PROTO_OCELOT_VALUE		15
 #define DSA_TAG_PROTO_AR9331_VALUE		16
 #define DSA_TAG_PROTO_RTL4_A_VALUE		17
@@ -80,6 +81,7 @@ enum dsa_tag_protocol {
 	DSA_TAG_PROTO_QCA		= DSA_TAG_PROTO_QCA_VALUE,
 	DSA_TAG_PROTO_TRAILER		= DSA_TAG_PROTO_TRAILER_VALUE,
 	DSA_TAG_PROTO_8021Q		= DSA_TAG_PROTO_8021Q_VALUE,
+	DSA_TAG_PROTO_YT921X		= DSA_TAG_PROTO_YT921X_VALUE,
 	DSA_TAG_PROTO_SJA1105		= DSA_TAG_PROTO_SJA1105_VALUE,
 	DSA_TAG_PROTO_KSZ8795		= DSA_TAG_PROTO_KSZ8795_VALUE,
 	DSA_TAG_PROTO_OCELOT		= DSA_TAG_PROTO_OCELOT_VALUE,
--- a/include/uapi/linux/if_ether.h
+++ b/include/uapi/linux/if_ether.h
@@ -114,6 +114,7 @@
 #define ETH_P_NCSI	0x88F8		/* NC-SI protocol               */
 #define ETH_P_PRP	0x88FB		/* IEC 62439-4 PRP/HSRv1        */
 #define ETH_P_CFM	0x8902		/* Connectivity Fault Management */
+#define ETH_P_YT921X	0x9988		/* Motorcomm YT921x switch tag  */
 #define ETH_P_FCOE	0x8906		/* Fibre Channel over Ethernet  */
 #define ETH_P_IBOE	0x8915		/* Infiniband over Ethernet     */
 #define ETH_P_TDLS	0x890D		/* Fast Initial Link Setup      */
--- a/net/dsa/Kconfig
+++ b/net/dsa/Kconfig
@@ -190,4 +190,10 @@ config NET_DSA_TAG_XRS700X
 	  Say Y or M if you want to enable support for tagging frames for
 	  Arrow SpeedChips XRS700x switches that use a single byte tag trailer.
 
+config NET_DSA_TAG_YT921X
+	tristate "Tag driver for Motorcomm YT921x switches"
+	help
+	  Say Y or M if you want to enable support for tagging frames for
+	  Motorcomm YT921x switches.
+
 endif
--- a/net/dsa/Makefile
+++ b/net/dsa/Makefile
@@ -40,3 +40,4 @@ obj-$(CONFIG_NET_DSA_TAG_TRAILER) += tag
 obj-$(CONFIG_NET_DSA_TAG_VAST) += tag_vast.o
 obj-$(CONFIG_NET_DSA_TAG_VSC73XX_8021Q) += tag_vsc73xx_8021q.o
 obj-$(CONFIG_NET_DSA_TAG_XRS700X) += tag_xrs700x.o
+obj-$(CONFIG_NET_DSA_TAG_YT921X) += tag_yt921x.o
--- a/drivers/net/dsa/Kconfig
+++ b/drivers/net/dsa/Kconfig
@@ -160,4 +160,12 @@ config NET_DSA_VSC73XX_PLATFORM
 	  This enables support for the Vitesse VSC7385, VSC7388, VSC7395
 	  and VSC7398 SparX integrated ethernet switches, connected over
 	  a CPU-attached address bus and work in memory-mapped I/O mode.
+
+config NET_DSA_YT921X
+	tristate "Motorcomm YT921x switch support"
+	depends on NET_DSA
+	select NET_DSA_TAG_YT921X
+	help
+	  This enables support for the Motorcomm YT921x switch family.
+
 endmenu
--- a/drivers/net/dsa/Makefile
+++ b/drivers/net/dsa/Makefile
@@ -26,3 +26,4 @@ obj-$(CONFIG_NET_DSA_SMSC_LAN9303_MDIO)	
 obj-$(CONFIG_NET_DSA_VSC73XX)		+= vsc73xx.o
 obj-$(CONFIG_NET_DSA_VSC73XX_PLATFORM)	+= vsc73xx_platform.o
 obj-$(CONFIG_NET_DSA_XRS700X)		+= xrs700x.o
+obj-$(CONFIG_NET_DSA_YT921X)		+= yt921x.o

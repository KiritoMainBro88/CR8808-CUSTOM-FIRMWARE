#!/bin/sh /etc/rc.common
# Copyright (C) 2026 CR8808-CUSTOM-FIRMWARE Project
# Procd Init Script for BoringTun Userspace WireGuard Daemon

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/boringtun

start_service() {
    config_load boringtun
    local enabled
    config_get_bool enabled global enabled 0
    [ "$enabled" -eq 1 ] || return 0

    local ifname threads log_level
    config_get ifname global interface "wg0"
    config_get threads global threads "2"
    config_get log_level global log_level "error"

    # Ensure /dev/net/tun is loaded
    [ -c /dev/net/tun ] || modprobe tun 2>/dev/null || true

    # Ensure socket directory exists
    mkdir -p /var/run/wireguard
    chmod 0700 /var/run/wireguard

    procd_open_instance "$ifname"
    procd_set_param command "$PROG" \
        --foreground \
        --threads "$threads" \
        --verbosity "$log_level" \
        --disable-drop-privileges \
        "$ifname"

    # Auto-respawn policy: respawn after 5 seconds, max 5 retries within 3600 seconds
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    config_load boringtun
    local ifname
    config_get ifname global interface "wg0"
    ip link del dev "$ifname" 2>/dev/null || true
    rm -f "/var/run/wireguard/${ifname}.sock" 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "boringtun"
}

#!/bin/sh
# config/tailscale/setup_subnet_router.sh.example
# Secondary Fallback Remote Access: Tailscale Subnet Router on Always-On Home LAN Node
# Target Subnet: Xiaomi CR8808 Ver.B LAN (192.168.31.0/24) [+ optional FPT ONT 192.168.100.0/24]
#
# CRITICAL ARCHITECTURAL GUARDRAIL:
#   DO NOT run 40 MB tailscale/tailscaled binaries directly on Xiaomi CR8808 Ver.B!
#   CR8808 only has ~182.5 MB total Linux RAM (~28.5 MB MemAvailable under baseline);
#   historical deployments on RA82 triggered OOM / connectivity outages.
#   Instead, run this on an always-on home PC / Raspberry Pi / SBC behind CR8808 LAN.

set -eu

SUBNET_ROUTES="${SUBNET_ROUTES:-192.168.31.0/24}"
HOST_KEY_FILE="${HOST_KEY_FILE:-config/cr8818_host_key.pub}"
DRY_RUN=0

if [ "${1:-}" = "--dry-run" ]; then
    DRY_RUN=1
fi

echo "=== Tailscale Home Subnet Router Plan (Secondary Fallback for Double NAT / CGNAT) ==="
echo "Advertised Routes : ${SUBNET_ROUTES}"
echo "Target CR8808 SSH : root@192.168.31.1:56789 (pinned against ${HOST_KEY_FILE})"
echo ""
echo "Prerequisites on Home Linux Node (Raspberry Pi / Always-On PC on 192.168.31.x):"
echo "  1. Enable IPv4 forwarding:"
echo "     sudo sysctl -w net.ipv4.ip_forward=1"
echo "  2. Bring up Tailscale advertising the home subnet (never exposing Dropbear directly to WAN):"
echo "     sudo tailscale up --advertise-routes=${SUBNET_ROUTES} --accept-dns=false"
echo "  3. Approve subnet route '${SUBNET_ROUTES}' in Tailscale Admin Console."
echo "  4. Once verified from school laptop via Tailscale, close public WAN SSH on CR8808:"
echo "     uci delete firewall.allow_wan_ssh && uci commit firewall && /etc/init.d/firewall reload"

if [ "$DRY_RUN" -eq 1 ]; then
    exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "[ERROR] Run as root (or pass --dry-run to inspect commands)." >&2
    exit 1
fi

if ! command -v tailscale >/dev/null 2>&1; then
    echo "[ERROR] 'tailscale' CLI not installed on this home LAN node." >&2
    exit 1
fi

sysctl -w net.ipv4.ip_forward=1
tailscale up --advertise-routes="${SUBNET_ROUTES}" --accept-dns=false

  clock-names = "stmmaceth",
         "pclk",
         "ptp_ref",
         "ahb",
         "axi",
         "rx",
         "tx";
  assigned-clocks = <&gcc 41>,
      <&gcc 38>,
      <&gcc 39>,
      <&gcc 92>,
      <&gcc 93>;
  assigned-clock-rates = <240000000>,
           <240000000>,
           <240000000>,
           <240000000>,
           <240000000>;
  resets = <&gcc 22>;
  reset-names = "stmmaceth";
  interrupts = <0 101 4>;
  interrupt-names = "macirq";

  phy-handle = <&ge_phy>;
  phy-mode = "sgmii";

  status = "disabled";
 };

 gmac1: ethernet@39d00000 {
  compatible = "qcom,ipq5018-gmac", "snps,dwmac";
  reg = <0x39d00000 0x10000>;
  reg-names = "stmmaceth";
  clocks = <&gcc 46>,
    <&gcc 43>,
    <&gcc 44>,
    <&gcc 94>,
    <&gcc 95>,
    <&gcc 45>,
    <&gcc 47>;
  clock-names = "stmmaceth",
         "pclk",

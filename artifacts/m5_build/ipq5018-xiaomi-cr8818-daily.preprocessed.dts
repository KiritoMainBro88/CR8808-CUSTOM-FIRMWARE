 };
};
# 5 "/mnt/d/vibecode/CR8808-CUSTOM-FIRMWARE/artifacts/m5_build/ipq5018-xiaomi-cr8818-daily.dts" 2

/ {
 model = "Xiaomi CR8818";
 compatible = "xiaomi,cr8818", "qcom,ipq5018";

 aliases {
  label-mac-device = &gmac0;
  led-boot = &led_system_blue;
  led-failsafe = &led_system_red;
  led-running = &led_system_blue;
  led-upgrade = &led_system_red;
 };

 keys {
  compatible = "gpio-keys";

  pinctrl-0 = <&button_pins>;
  pinctrl-names = "default";

  reset-button {
   label = "reset";
   gpios = <&tlmm 38 1>;
   linux,code = <0x198>;
  };

  mesh-button {
   label = "mesh";
   gpios = <&tlmm 28 1>;
   linux,code = <0x100>;
  };
 };

 leds {
  compatible = "gpio-leds";

  pinctrl-0 = <&leds_pins>;
  pinctrl-names = "default";

  led_system_blue: system-blue {
   color = <3>;
   function = "power";
   gpios = <&tlmm 24 0>;
  };

  led_system_red: system-red {
   color = <1>;
   function = "power";
   gpios = <&tlmm 25 0>;
  };

  led_internet_blue: internet-blue {
   color = <3>;
   function = "wan";
   gpios = <&tlmm 26 0>;
  };

  led_internet_red: internet-red {
   color = <1>;
   function = "wan";
   gpios = <&tlmm 27 0>;
  };
 };
};

&art {
 nvmem-layout {
  compatible = "fixed-layout";
  #address-cells = <1>;
  #size-cells = <1>;

  mac_addr_gmac0: macaddr@0 {
   reg = <0x0 0x6>;
  };

  mac_addr_gmac1: macaddr@6 {
   reg = <0x6 0x6>;
  };
 };
};

&uniphy0 {
 status = "okay";

 assigned-clocks = <&uniphy0 2>;
 assigned-clock-rates = <50000000>;
};


&gmac0 {
 status = "okay";
 label = "wan";
 nvmem-cells = <&mac_addr_gmac0 0>;
 nvmem-cell-names = "mac-address";
};


&gmac1 {
 status = "okay";
 phy-mode = "2500base-x";
 nvmem-cells = <&mac_addr_gmac1 0>;
 nvmem-cell-names = "mac-address";

 fixed-link {
  speed = <2500>;
  full-duplex;
  pause;
  asym-pause;
 };
};

&mdio0 {
 status = "okay";
};

&ge_phy {
 qcom,dac-preset-short-cable;
};

&mdio1 {
 status = "okay";
 pinctrl-0 = <&mdio1_pins>;
 pinctrl-names = "default";
 reset-gpios = <&tlmm 39 1>;


 ethernet-switch@1d {
  compatible = "motorcomm,yt9215";
  reg = <0x1d>;

  mdio {
   #address-cells = <1>;
   #size-cells = <0>;

   sw_phy0: phy@0 { reg = <0x0>; };
   sw_phy1: phy@1 { reg = <0x1>; };
   sw_phy2: phy@2 { reg = <0x2>; };
   sw_phy3: phy@3 { reg = <0x3>; };
   sw_phy4: phy@4 { reg = <0x4>; };
  };

  ethernet-ports {
   #address-cells = <1>;
   #size-cells = <0>;

   ethernet-port@0 {
    reg = <0>;
    label = "lan1";
    phy-mode = "internal";
    phy-handle = <&sw_phy0>;
   };

   ethernet-port@1 {
    reg = <1>;
    label = "lan2";
    phy-mode = "internal";
    phy-handle = <&sw_phy1>;
   };

   ethernet-port@2 {
    reg = <2>;
    label = "lan3";
    phy-mode = "internal";
    phy-handle = <&sw_phy2>;
   };

   ethernet-port@3 {
    reg = <3>;
    label = "sw-wan";
    phy-mode = "internal";
    phy-handle = <&sw_phy3>;
   };

   ethernet-port@4 {
    reg = <4>;
    label = "sw-cpu";
    phy-mode = "internal";
    phy-handle = <&sw_phy4>;
   };

   ethernet-port@8 {
    reg = <8>;
    phy-mode = "2500base-x";
    ethernet = <&gmac1>;

    fixed-link {
     speed = <2500>;
     full-duplex;
     pause;
     asym-pause;
    };
   };
  };
 };
};

&tlmm {
 button_pins: button-state {
  pins = "gpio38", "gpio28";
  function = "gpio";
  drive-strength = <8>;
  bias-pull-up;
 };

 leds_pins: leds-state {
  pins = "gpio24", "gpio25", "gpio26", "gpio27";
  function = "gpio";
  drive-strength = <8>;
  bias-pull-down;
 };
};


&wifi {
 status = "okay";
 qcom,rproc = <&q6_wcss_pd1>;
 qcom,ath11k-calibration-variant = "Xiaomi-CR8818";
 qcom,ath11k-fw-memory-mode = <1>;
 qcom,bdf-addr = <0x4c400000>;
};


&wifi1 {
 status = "okay";
 qcom,rproc = <&q6_wcss_pd2>;
 qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
 qcom,ath11k-calibration-variant = "Xiaomi-CR8818";
 qcom,ath11k-fw-memory-mode = <1>;
 qcom,bdf-addr = <0x4d100000>;
 qcom,m3-dump-addr = <0x4df00000>;
};

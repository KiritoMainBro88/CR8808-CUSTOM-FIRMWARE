      <&gcc 95>;
  assigned-clock-rates = <240000000>,
           <240000000>,
           <240000000>,
           <240000000>,
           <240000000>;
  resets = <&gcc 25>;
  reset-names = "stmmaceth";
  interrupts = <0 109 4>;
  interrupt-names = "macirq";

  pcs-handle = <&uniphy0>;

